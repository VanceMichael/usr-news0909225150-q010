{
  "name": "temporary-sea-zone-domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "domain:check": "node scaffold/validate.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test:unit": "npm run build && node --test dist/test/geometry.test.js",
    "test:integration": "node --test dist/test/integration.test.js",
